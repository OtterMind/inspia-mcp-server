# No database, provider credentials, or Inspia account is needed.
INSPIA_BASE_URL=https://inspia.ai
MCP_HOST=127.0.0.1
MCP_PORT=8788
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Exact origins. Requests with no Origin (normal MCP clients) are accepted.
MCP_ALLOWED_ORIGINS=http://localhost:8788,http://127.0.0.1:8788
MCP_ENABLED=true
# Optional in development; required for non-loopback binds. Generate 32+ random characters.
# Reuse the same secret on all replicas to keep cursors portable across requests.
MCP_CURSOR_SECRET=
MCP_RATE_LIMIT=60
MCP_MAX_CONCURRENT=16
INSPIA_TIMEOUT_MS=15000
